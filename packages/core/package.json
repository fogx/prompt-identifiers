{
  "name": "prompt-identifiers",
  "version": "0.1.0",
  "description": "Efficient ID compression for LLM prompts in JS/TS/Node. Reduce token usage by up to 90%. UUID, ULID, regex",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "jest",
    "bench": "tsx bench/benchmark.ts",
    "bench:accuracy": "tsx bench/accuracy/run.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "llm",
    "ai",
    "tokens",
    "compression",
    "prompt",
    "uuid",
    "ulid"
  ],
  "author": "Leon Wolf <fogxdev@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fogx/prompt-identifiers"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@faker-js/faker": "^9.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "dotenv": "^17.2.3",
    "jest": "^29.0.0",
    "openai": "^4.0.0",
    "ts-jest": "^29.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "uuid": "^11.0.0"
  }
}
