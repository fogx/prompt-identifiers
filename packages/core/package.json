{
  "name": "prompt-identifiers",
  "version": "0.1.4",
  "description": "Efficient ID compression for LLM prompts in JS/TS/Node. Reduce token usage by up to 90%. UUID, ULID, regex",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --format cjs --dts --sourcemap",
    "test": "vitest run",
    "bench": "tsx bench/benchmark.ts",
    "bench:accuracy": "tsx bench/accuracy/run.ts",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "keywords": [
    "llm",
    "ai",
    "tokens",
    "compression",
    "prompt",
    "uuid",
    "ulid"
  ],
  "author": "Leon Wolf <fogxdev@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fogx/prompt-identifiers"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^22.20.2",
    "dotenv": "^17.4.2",
    "openai": "^7.15.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "uuid": "^14.0.2",
    "vitest": "^5.0.0"
  }
}
