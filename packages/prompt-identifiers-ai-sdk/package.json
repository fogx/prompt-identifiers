{
  "name": "prompt-identifiers-ai-sdk",
  "version": "0.3.0",
  "description": "Vercel AI SDK middleware for prompt-identifiers. Efficient ID compression for token optimization.",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --format cjs --dts",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "llm",
    "ai",
    "vercel",
    "ai-sdk",
    "middleware",
    "tokens",
    "compression",
    "prompt",
    "uuid",
    "ulid"
  ],
  "author": "Leon Wolf <fogxdev@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fogx/prompt-identifiers"
  },
  "peerDependencies": {
    "@ai-sdk/provider": ">=4.0.0",
    "ai": ">=7.0.0",
    "prompt-identifiers": ">=0.1.4"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.14",
    "@types/node": "^22.20.2",
    "ai": "^7.0.99",
    "prompt-identifiers": "workspace:*",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
